<mxfile host="app.diagrams.net" modified="2026-11-08T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="crownfield" name="Final ERD"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="banner" value="&lt;span style=&quot;color:#FFFFFF;font-size:24px;&quot;&gt;&lt;b&gt;CROWNFIELD EYE HOSPITAL&lt;/b&gt; | Relational Database — Entity Relationship Diagram (ERD)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#11345b;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1620" height="68" as="geometry"/></mxCell><mxCell id="db" value="Database: crownfield_ro_pl_demo | MySQL 8.4.11" style="text;html=1;strokeColor=none;fillColor=#edf4ff;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="69" width="300" height="36" as="geometry"/></mxCell><mxCell id="legend" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #23486e&quot;&gt;Legend — Crow&amp;#x27;s Foot Notation&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.3;padding:5px 8px;&quot;&gt;PK  Primary Key&lt;br&gt;FK  Foreign Key&lt;br&gt;UQ  Unique Constraint&lt;br&gt;NN  Not Null (mandatory)&lt;br&gt;NULL  Nullable (optional)&lt;br&gt;1  Exactly one&lt;br&gt;0..1  Zero or one&lt;br&gt;0..*  Zero or many&lt;br&gt;1..*  One or many&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f6fc;strokeColor=#23486e;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="280" height="305" as="geometry"/></mxCell><mxCell id="constraints" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #23486e&quot;&gt;Key Constraints (from SQL)&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.3;padding:5px 8px;&quot;&gt;Appointment.Status: NOT NULL;&lt;br&gt;DEFAULT &amp;#x27;Scheduled&amp;#x27;;&lt;br&gt;CHECK Scheduled / Completed / Cancelled&lt;br&gt;&lt;br&gt;Clinician.Email: UNIQUE (nullable)&lt;br&gt;Patient.Email: UNIQUE (nullable)&lt;br&gt;Follow_Up.Appointment_ID: UNIQUE&lt;br&gt;Medicine.Medicine_Name: UNIQUE&lt;br&gt;Prescription_Item.Quantity &amp;gt; 0&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f6fc;strokeColor=#23486e;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="10" y="455" width="280" height="355" as="geometry"/></mxCell><mxCell id="specialty" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #159447&quot;&gt;SPECIALTY&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.4;padding:5px 8px;&quot;&gt;Specialty_ID : INT [PK, NN]&lt;br/&gt;Specialty_Name : VARCHAR(100)&lt;br/&gt;[UQ, NN]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e4;strokeColor=#159447;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="310" y="145" width="250" height="140" as="geometry"/></mxCell><mxCell id="clinician" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #159447&quot;&gt;CLINICIAN&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.3;padding:5px 8px;&quot;&gt;Clinician_ID : INT [PK, NN]&lt;br&gt;First_Name : VARCHAR(60) [NN]&lt;br&gt;Last_Name : VARCHAR(60) [NN]&lt;br&gt;Specialty_ID : INT [FK, NN]&lt;br&gt;Email : VARCHAR(120) [UQ, NULL]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e4;strokeColor=#159447;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="625" y="120" width="270" height="177" as="geometry"/></mxCell><mxCell id="clinic" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #159447&quot;&gt;CLINIC&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.3;padding:5px 8px;&quot;&gt;Clinic_ID : INT [PK, NN]&lt;br&gt;Clinic_Name : VARCHAR(120) [NN]&lt;br&gt;Hospital_Name : VARCHAR(140) [NN]&lt;br&gt;City : VARCHAR(80) [NN]&lt;br&gt;Country : VARCHAR(40) [NN]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2e4;strokeColor=#159447;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1090" y="105" width="260" height="177" as="geometry"/></mxCell><mxCell id="patient" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #e92d85&quot;&gt;PATIENT&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.3;padding:5px 8px;&quot;&gt;Patient_ID : VARCHAR(10) [PK, NN]&lt;br&gt;First_Name : VARCHAR(60) [NN]&lt;br&gt;Last_Name : VARCHAR(60) [NN]&lt;br&gt;Date_Of_Birth : DATE [NN]&lt;br&gt;City : VARCHAR(80) [NN]&lt;br&gt;Phone : VARCHAR(25) [NULL]&lt;br&gt;Email : VARCHAR(120) [UQ, NULL]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9dce9;strokeColor=#e92d85;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;overflow=fill;" vertex="1" parent="1"><mxGeometry x="315" y="370" width="295" height="240" as="geometry"/></mxCell><mxCell id="appointment" value="&lt;div style=&quot;text-align:center;font-size:17px;font-weight:bold;padding:3px 0;border-bottom:1px solid #2585e7&quot;&gt;APPOINTMENT&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;